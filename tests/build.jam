import feature ;
import testing ;

variant pedantic : debug ;

project /bfg_lyra_tests
	: requirements
		<toolset>clang:<cxxflags>-fcolor-diagnostics
		<include>../examples
		<variant>debug:<define>LYRA_DEBUG=1
		<conditional>@pedantic
	: default-build
		<variant>pedantic
	;

rule pedantic ( p * )
{
	local r ;
	local t = [ feature.get-values <toolset> : $(p) ] ;
	if ( <variant>pedantic in $(p) ) && ( $(t) in gcc clang )
	{
		r +=
			<cxxflags>-Woverloaded-virtual
			<cxxflags>-Wshadow
			<cxxflags>-Wnon-virtual-dtor
			<cxxflags>-Wzero-as-null-pointer-constant
			<cxxflags>-Wsign-promo
			<cxxflags>-Wsign-compare
			<cxxflags>-Wsign-conversion
			<cxxflags>-Wundef
			;
	}
	r +=
		<warnings>pedantic
		<warnings-as-errors>on
		;
	return $(r) ;
}

for local test in [ glob *_compile_test.cpp ]
{
	compile $(test) : requirements <use>/bfg_lyra  ;
}
for local test in [ glob *_run_test.cpp ]
{
	run $(test) : requirements <use>/bfg_lyra ;
}

compile-fail single_include_test.cpp : : single_include_test_fail ;
compile single_include_test.cpp
	: <include>../data/single_include ;

run optional_type_test.cpp : requirements <use>/bfg_lyra ;

compile issue_93_test.cpp : requirements <use>/bfg_lyra <cxxstd>11:<build>no ;

build-project lib_use_test ;
